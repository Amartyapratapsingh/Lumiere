# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your keys.  `.env` is git-ignored.
#
#   cp .env.example .env      (or copy it in Explorer and rename)
#
# The site runs fine with all of these blank — Clerk falls back to the built-in
# password login, and Resend just prints emails to the terminal instead of
# sending them.  Fill each section in when you're ready for it.
# ─────────────────────────────────────────────────────────────────────────────


# ── Clerk (sign-up / sign-in) ────────────────────────────────────────────────
# 1. Create a free app at https://dashboard.clerk.com
# 2. Open  Configure → API keys
# 3. Copy the two keys below.
#
# The moment BOTH are filled in, Clerk takes over authentication and the
# built-in password login is switched off automatically.

VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=


# ── Resend (transactional email) ─────────────────────────────────────────────
# 1. Create a free account at https://resend.com
# 2. Open  API Keys → Create API Key  (permission: "Sending access")
# 3. Paste it below.

RESEND_API_KEY=

# Who the emails come from.
#
# Leave as-is to use Resend's shared test sender — it works with no setup, but
# will ONLY deliver to the email address you signed up to Resend with.
#
# To email real customers, verify your own domain at
# https://resend.com/domains and then use something like:
#   RESEND_FROM="Lumière <orders@yourdomain.com>"
RESEND_FROM="Lumière <onboarding@resend.dev>"

# Where "new order" alerts go while you're testing.  Seeded demo sellers use
# fake @lumiere.in addresses that can't receive mail, so alerts for them are
# redirected here instead.  Leave blank to skip those alerts entirely.
SELLER_ALERT_OVERRIDE=


# ── App ──────────────────────────────────────────────────────────────────────
PORT=4000
# Used to build links inside emails.
PUBLIC_URL=http://localhost:5173
